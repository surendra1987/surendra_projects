#
# This file defines the behat default settings, only chrome browser is fully supported.
#
# Developers may add custom settings via behat_local.yml file in the this directory,
# for example to add firefox profile you need to override the extra_capabilities with empty array.
#
default:
  formatters:
    moodle_progress:
      output_styles:
        comment:
          - magenta
  suites:
    default:
      paths: { }
      contexts: { }
  extensions:
    Behat\MinkExtension:
      base_url: 'http://127.0.0.1:8080/Totara/wwwroot'
      browserkit_http: null
      webdriver:
        browser: 'chrome'
        wd_host: 'http://127.0.0.1:4444/wd/hub'
        capabilities:
          extra_capabilities:
            'goog:chromeOptions':
              args:
                - '--disable-background-timer-throttling'
                - '--disable-backgrounding-occluded-windows'
              excludeSwitches:
                - enable-automation
              prefs:
                credentials_enable_service: false
    Moodle\BehatExtension:
      moodledirroot: /Should/Change/To/Totara/dirroot
      steps_definitions: {  }
firefox:
  extensions:
    Behat\MinkExtension:
      webdriver:
        browser: 'firefox'
headless:
  extensions:
    Behat\MinkExtension:
      webdriver:
        browser: chrome
        capabilities:
          extra_capabilities:
            'goog:chromeOptions':
              args:
                - '--disable-background-timer-throttling'
                - '--disable-backgrounding-occluded-windows'
                - '--headless'
              excludeSwitches:
                - enable-automation