{
  "name": "totara/totara_behat",
  "description": "Totara Behat related code",
  "license": "GPL-3.0-or-later",
  "type": "library",
  "homepage": "https://www.totaralearning.com",
  "require-dev": {
    "behat/mink": "1.11.0",
    "friends-of-behat/mink-extension": "2.7.5",
    "behat/mink-browserkit-driver": "2.2.0",
    "symfony/process": "6.4.8",
    "symfony/http-client": "6.4.7",
    "behat/behat": "3.14.0",
    "oleg-andreyev/mink-phpwebdriver": "1.3.*",
    "guzzlehttp/guzzle": "7.8.1",
    "symfony/mime": "6.4.7"
  },
  "require": {
    "php": ">=8.1 <8.4",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-date": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-hash": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-pcre": "*",
    "ext-session": "*",
    "ext-SimpleXML": "*",
    "ext-SPL": "*",
    "ext-xml": "*",
    "ext-xmlreader": "*",
    "ext-zip": "*",
    "ext-zlib": "*"
  },
  "autoload": {
    "psr-0": {
      "Moodle\\BehatExtension\\": "extension/src/"
    }
  }
}
