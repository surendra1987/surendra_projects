{
  "name": "totara/totara_require",
  "description": "Required libraries used in production",
  "type": "metapackage",
  "homepage": "https://www.totara.com",
  "version": "1.0.0+no-version-set",
  "require": {
    "php": ">=8.1 <8.4",
    "ezyang/htmlpurifier": "4.17.0",
    "phpmailer/phpmailer": "6.9.1",
    "webonyx/graphql-php" : "v15.11.1",
    "openspout/openspout": "v4.23.0",
    "simplepie/simplepie": "1.8.0",
    "dompdf/dompdf": "dev-totara-2.0.4#2.0.4-totara",
    "sabberworm/php-css-parser": "dev-totara-8.5.1#8.5.1-totara as 8.5.1",
    "phpoffice/phpspreadsheet" : "dev-totara-2.0.0#2.0.0-totara",
    "opis/json-schema": "2.3.0",
    "adodb/adodb-php": "5.22.7",
    "michelf/php-markdown": "2.0.0",
    "nyholm/psr7": "1.8.1",
    "lcobucci/jwt": "5.3.0",
    "league/oauth2-server": "8.5.4",
    "matthiasmullie/minify": "1.3.73",
    "geoip2/geoip2": "3.0.0",
    "totara/xhprof": "dev-totara-2.3.9#2.3.9-totara",
    "goat1000/svggraph": "dev-totara-3.20.0#3.20.0-totara",
    "setasign/fpdi": "2.6.0",
    "wikimedia/less.php": "4.2.1",
    "scssphp/scssphp": "dev-totara-1.12.1#1.12.1-totara",
    "phpseclib/phpseclib": "3.0.37",
    "litesaml/lightsaml": "v4.2.0",
    "paragonie/constant_time_encoding": "2.6.3",
    "symfony/polyfill-php82": "^1.29",
    "symfony/polyfill-php83": "^1.29"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/totara/xhprof"
    },
    {
      "type": "vcs",
      "url": "https://github.com/totara/SVGGraph"
    },
    {
      "type": "vcs",
      "url": "https://github.com/totara/scssphp"
    },
    {
      "type": "vcs",
      "url": "https://github.com/totara/dompdf"
    },
    {
      "type": "vcs",
      "url": "https://github.com/totara/PhpSpreadsheet"
    },
    {
      "type": "vcs",
      "url": "https://github.com/totara/PHP-CSS-Parser"
    }
  ],
  "replace": {
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-iconv": "*"
  },
  "config": {
    "vendor-dir": "./",
    "optimize-autoloader": true
  }
}
