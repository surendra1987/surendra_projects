  * timecreated
  * timemodified
  * shortname

  Note: Currently, sorting is limited to a single column at a time.
  """
  sort: [core_sort_input!]
}

"""
Seminars filters.
"""
input mod_facetoface_seminars_filters {
  """
  Filters by a specific set of seminar IDs.
  """
  ids: [core_id!]
  """
  Filters seminars which have been modified after a given date time.
  Handles the following formats: integer timestamp, numeric string or an ISO-8601 string.
  """
  since_timemodified: core_date
}

extend type Query {
  """
