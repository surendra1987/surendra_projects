{{!
    @template mod_approval/report

    Wrapper for a participation report

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * reportid: string
    * heading: string
    * import_button: HTML
}}
<div class="page-heading"
     data-core-autoinitialise="true"
     data-core-autoinitialise-amd="totara_reportbuilder/report"
     data-report-id="{{reportid}}">
  {{! Opt for a much simpler approach if we can't edit the title}}
    <h1>{{heading}}</h1>
    <div class="page-heading-buttons">{{{import_button}}}</div>
</div>