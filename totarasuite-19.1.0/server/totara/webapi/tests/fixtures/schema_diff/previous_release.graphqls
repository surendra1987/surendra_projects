"""
An instance of a webhook resource.

Webhook for sending event data to an external source
"""
type totara_webhook_totara_webhook {
  "The internal database id of the webhook."
  id: core_id!

  "Name of the webhook"
  name: String!

  "URL the webhook data will be sent to"
  endpoint: String!

  "Events that the webhook is subscribed to"
  events: [String]

  "Unix timestamp when the record was created."
  created_at(format: core_date_format = TIMESTAMP): core_date

  "Unix timestamp when the record was last updated."
  updated_at(format: core_date_format = TIMESTAMP): core_date

  "Is the webhook enable\/disabled - enabled = true"
  status: Boolean

  "Do we send the payload immediately after the event"
  immediate: Boolean

  "The authentication method this webhook uses (e.g. webhook_hmac_auth)"
  auth_class: String

  "The authentication data required by the auth_class to authenticate webhook payloads"
  auth_config: String
}

"""
Input for identifying a webhook.

The webhook must be specified by providing one of the following:

* The internal database id
"""
input totara_webhook_totara_webhook_reference {
