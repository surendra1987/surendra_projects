"""
The result of the add_cohort_member mutation.
This object contains:
- the user object that was requested
- the audience object to which the user should be added
- whether the operation to add the user to the audience was successful
- whether the user was already a member of the audience
Note that if the user was already a member of the selected audience,
the 'success' field will be 'False' since the user was not added as a result of this request.
"""
type core_cohort_add_cohort_member_result {
  "User object for the user that is added to the audience."
  user: core_user!

  "Audience object."
  cohort: core_cohort!

  "Whether the user is added into audience by this request."
  success: Boolean!

  """
  Whether the user was already a member of the audience.
  If so, this operation will technically have failed, but the end result is the same as if it had succeeded.
  """
  was_already_member: Boolean!
}

"""
Result returned from the core_cohort_remove_cohort_member mutation.
Contains audience information and flags to let you know whether
the member was removed from the audience.
"""
type core_cohort_remove_cohort_member_result {
  "User object for the user that is removed from the audience."
  user: core_user!

  "Audience object."
  cohort: core_cohort!

  "Whether the user was removed from the audience as a result of this request."
  success: Boolean!

  """
  Whether the user was the member of the audience.
  If so, this operation will technically have failed, but the end result is the same as if it had succeeded.
  """
  user_was_member: Boolean!
}

