"""
Represents standard unix timestamps stored in database.

For input, use either an integer timestamp, numeric string or an ISO-8601 string.

Output can usually be selected via format argument. See core_date_format
enum for the list of supported formats.
"""
scalar core_date

"Constant for the audience type."
enum core_cohort_type {
  STATIC
  DYNAMIC
}

"Audience type object, containing information about an audience."
type core_cohort {
  "Internal database id of the audience."
  id: core_id!

  "Audience name."
  name(format: core_format = PLAIN): String!

  "The id number of the audience."
  idnumber(format: core_format = PLAIN): String

  "Audience description."
  description(format: core_format = HTML): String

  "Audience type."
  type: core_cohort_type!

  "Whether the audience is active."
  active: Boolean!

  "The number of audience members."
  members_count: Int!

  "The tags of static cohorts."
  tags: [core_tag]!
}

"Context type object, containing information about a context."
type core_context {
