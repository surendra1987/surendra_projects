  mod_certificate_sync_completion(input: totara_mobile_sync_completion_input!): totara_mobile_sync_completion_result!

  mod_contentmarketplace_set_self_completion(cm_id: core_id!, status: param_boolean!): Boolean! @deprecated(reason: "Using mod_contentmarketplace_request_non_interactive_enrol_v2 instead")
  mod_contentmarketplace_request_non_interactive_enrol(cm_id: core_id!): Boolean!
  mod_contentmarketplace_request_non_interactive_enrol_v2(cm_id: core_id!): mod_contentmarketplace_request_non_interactive_enrol_result!

  "Cancel a user booking\/signup for a seminar event."
  mod_facetoface_event_cancel_user_booking(
    "Input for cancelling a seminar event booking\/signup."
    input: mod_facetoface_event_cancel_user_booking_input!
  ): mod_facetoface_event_cancel_user_booking_result!

  """
  Create a user booking/signup for a seminar event.
  This service attempts to create a user booking in any one of the states of BOOKED, REQUESTED, REQUESTED_ROLE, or WAITLISTED. See `mod_facetoface_booking_state_key` for full definitions of states.
  """
  mod_facetoface_event_create_user_booking(
    "Input for creating a seminar event booking\/signup."
    input: mod_facetoface_event_create_user_booking_input!
  ): mod_facetoface_event_create_user_booking_result!

  "Save label completion"
  mod_label_sync_completion(input: totara_mobile_sync_completion_input!): totara_mobile_sync_completion_result!

  "Save page completion"
  mod_page_sync_completion(input: totara_mobile_sync_completion_input!): totara_mobile_sync_completion_result!

  "Create an activity"
  mod_perform_create_activity(name: String!, description: String, type: core_id!): mod_perform_activity_result!

  "Update an activity"
  mod_perform_update_activity(
    activity_id: core_id!
