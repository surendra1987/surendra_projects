  """
  Determines to complete the activity. Complete value can be either boolean or NULL and depends on completion settings.
  1. Completed is boolean if the completion setting is 'TRACKING_MANUAL'
  2. Completed is NULL if the completion setting is 'TRACKING_AUTOMATIC' or 'TRACKING_NONE'
  """
  completed: Boolean

  "Completion tracking enum."
  completion_tracking: totara_mobile_completion_tracking_input!
}

"Constant for completion tracking."
enum totara_mobile_completion_tracking_input {
  TRACKING_MANUAL
  TRACKING_AUTOMATIC
  TRACKING_NONE
}

