  items: [totara_api_client!]!

  "Total number of api clients from this query."
  total: Int!

  "Cursor to request the next set of results for this query."
  next_cursor: String!
}

"Return client settings result including global level and client level."
type totara_api_client_settings_result {
  "Client level client settings"
  client_settings: totara_api_client_settings!

  "Global level client settings"
  global_settings: totara_api_global_client_settings!
}

"Client result."
type totara_api_client_result {
  client: totara_api_client!
}

"Input provided when searching for a user"
input totara_api_search_users_input {
  "Tenant id."
  tenant_id: core_id

  "User search text."
  pattern: param_text
}

"Returned user search result."
type totara_api_search_users_result {
  users: [core_user]!
}

"Service account information for the API user."
type totara_api_client_service_account {
  "User type containing data about the service account user."
  user: core_user

  "True if the real-time validation checks indicate the user is suitable to be a service account for this client, false otherwise."
  is_valid: Boolean!

  "Status about the user and service account if invalid."
  status: totara_api_client_service_account_status!
}

"Constant representing cause of an validation issue."
enum totara_api_client_service_account_status {
  VALID
  NO_USER
  DELETED
  SUSPENDED
  GUEST
  ADMIN
  WRONG_TENANT
  TENANT_SUSPENDED
}

"Input provided when updating an existing API client."
input totara_api_update_client_input {
  id: core_id!

  "Name used to identify the client."
  name: String

  "User defined description of the purpose\/use for this client."
  description: String

  "The enabled status of the client."
  status: Boolean

  "The API service account user for the client."
  user_id: core_id
}

"""
Parameters used to define catalog search query.

Use either query_string or query_structure.

The format of this input matches the URL query parameters used with the Totara 'grid' or 'explore' catalogs, one of which must be enabled to use this API.
"""
input totara_catalog_url_query_input {
  """
  URL query string. Query string from any existing catalog search can be used here. Use this option for the first page of results only.
  
  The list of expected query keys for query_string search:
  - Active filter aliases
  - objecttype
  - perpageload
  - orderbykey
  """
  query_string: String

  """
  URL query structure as a JSON blob of key-value pairs. Use this option if you need pagination.
  
  The list of expected query keys for query_structure search:
  - Active filter aliases
  - objecttype
  - perpageload
  - orderbykey
  - limitfrom (pagination cursor; only for pages 2 through n)
  """
  query_structure: String
}

"URL query validation result type, provides metadata about a given query."
type totara_catalog_url_query_validation_result {
  "Total number of learning items."
  total_count: Int!

  "The flag to indicate the URL query has error or not."
  error: Boolean!

  "Error message."
  error_message: String
}

"Generic catalog filter option type."
type totara_catalog_option {
  "Option id."
  id: String!

  "Option label."
  label: String!

  "Option is active or not, in other words, it's selected\/default or not."
  active: Boolean!
}

"Catalog tree filter option type, used for hierarchical options."
type totara_catalog_tree_option {
  "Node id."
  id: String!

  "Node parent id, might be null if top-level."
  parentid: String

  "Node name."
  label: String!

  "Option is active or not, in other words, it's selected\/default or not."
  active: Boolean!
}

"Catalog filter type, collects a named group of options with a defined key for use in catalog queries."
type totara_catalog_filter {
  "Filter key that is catalog url query param eg ?course_type_panel[]=1."
  key: String!

  "Filter title \/ label."
  title: String!

  "Option type."
  type: String!

  "Filter options."
  options: [totara_catalog_filter_option_union]!
}

"Union type allowing for different types of filter option to be used"
union totara_catalog_filter_option_union = totara_catalog_option | totara_catalog_tree_option

"Filters query result, lists the active filters and sorting options in the catalog."
type totara_catalog_filters_result {
  "Active filters."
  filters: [totara_catalog_filter]!

  "Filter selected as \"Browse filter\"."
  browse_filter: totara_catalog_filter

  "Sort option."
  sort: totara_catalog_filter
}

"Catalog learning items result. Contains a page of learning items which match a query, and metadata about the page and total result set."
type totara_catalog_items_result {
  "Catalog learning items."
  items: [totara_catalog_item]!

  "The cursor to use in query_structure input to fetch the next page of items."
  limitfrom: String!

  "The approximate total number of items in the result set. Due to visibility restrictions, this number may not be an accurate total."
  maxcount: Int!

  "Active filters."
  filters: [totara_catalog_filter]

  "Filter selected as \"Browse filter\"."
  browse_filter: totara_catalog_filter

  "Sort options."
  sort: totara_catalog_filter

  "Flag to indicate whether the query has any filters applied or not."
  is_filtered: Boolean!

  "Flag to indicate if there are any more records to load."
  endofrecords: Boolean!

  "Proposed alternative search term"
  suggestion: String
}

"Catalog learning item type, used to display information about an individual learning item in a card."
type totara_catalog_item {
  "Catalog item database id. This is different from the item's actual course or resource id."
  itemid: core_id!

  "Type of catalog item (singular), e.g. Course"
  type_label: String!

  "Item title."
  title: String!

  "'Featured' is enabled or not for this item."
  featured: Boolean!

  "Item URL. This URL may contain additional parameters that redirect the user back to the catalog."
  redirecturl: String!

