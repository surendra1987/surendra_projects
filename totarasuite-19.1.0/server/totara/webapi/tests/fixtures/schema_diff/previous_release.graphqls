  Please note: creating organisations requires the capability 'totara/hierarchy:createorganisation'
  """
  hierarchy_organisation_create_organisation(
    "Input object specifying data for creating the new organisation."
    input: hierarchy_organisation_create_organisation_input!
  ): hierarchy_organisation_organisation_created_result!

  """
  Updates a specific target organisation with new properties.
  Please note: updating organisations requires the capability 'totara/hierarchy:updateorganisation'
  """
  hierarchy_organisation_update_organisation(
    "The organisation that should be updated."
    target_organisation: hierarchy_organisation_organisation_reference!

    "Input object specifying data for updating the organisation."
    input: hierarchy_organisation_update_organisation_input!
  ): hierarchy_organisation_organisation_updated_result!

  """
  Mutation to delete an organisation.
  Please note: deleting organisations requires the capability 'totara/hierarchy:deleteorganisation'
  """
  hierarchy_organisation_delete_organisation(
    "Input provided for identifying the organisation."
    target_organisation: hierarchy_organisation_organisation_reference!
  ): hierarchy_organisation_organisation_deleted_result!

  """
  Creates a new position.
  Please note: creating positions requires the capability 'totara/hierarchy:createposition'
  """
  hierarchy_position_create_position(
    "Input object specifying data for creating the new position."
    input: hierarchy_position_create_position_input!
  ): hierarchy_position_position_created_result!

  """
  Updates a specific target position with new properties.
  Please note: updating positions requires the capability 'totara/hierarchy:updateposition'
  """
  hierarchy_position_update_position(
    "The position that should be updated."
    target_position: hierarchy_position_position_reference!

    "Input object specifying data for updating the position."
    input: hierarchy_position_update_position_input!
  ): hierarchy_position_position_updated_result

  """
  Mutation to delete an position.
  Please note: deleting positions requires the capability 'totara/hierarchy:deleteposition'
  """
  hierarchy_position_delete_position(
    "Input provided for identifying the position."
    target_position: hierarchy_position_position_reference!
  ): hierarchy_position_position_deleted_result!
}

"Core mutation success\/fail result type."
type core_mutation_result {
  "Whether the operation succeeded."
  success: Boolean!

  "Optional return url, can be used to indicate where the client should redirect the user to."
  return_url: String

  "Optional human readable string describing the success or error."
  message: String

  """
  Optional code, often a lang string key, representing the class of success or error.
  
  Mutations must document any codes used for this purpose.
  """
  code: String
}

"Core query type"
type Query {
  "Placeholder query because Query type declaration can't be empty"
  placeholder_query: Boolean

  core_ai_course_suggest_tags(input: core_ai_suggest_tags_input!): core_ai_suggest_tags_result

  "Return a single category from its ID"
  core_category(categoryid: core_id!): core_category!

  """
  Return all the categories that are available to be maintained
  by the user only, no system categories in this list.
  """
  core_categories: [core_category!]!

  """
  Return all categories in the specified category visible to the current user. Excludes non-direct decendants
  (sub-sub-categories).
  """
  core_categories_by_parent_category(
    "The id of the parent category to return the children of."
    categoryid: core_id!

    "Order of categories to return."
    sort: core_category_sort_order = SORTORDER
  ): [core_category!]!

  core_cohorts(query: core_cohorts_query): core_cohorts_result!

  "Return a single course from its id if the user can access it."
  core_course(courseid: core_id!): core_course!

  "Return a group of courses from a given list of ids."
  core_course_list(course_ids: [core_id!]): [core_course]!

  "Return all the current user's enrolled courses. Internally calls enrol_get_my_courses()."
  core_my_courses(sort: core_course_sort_order = SORTORDER): [core_course!]!

  "Return all courses in the specified category visible to the current user. Excludes courses inside sub-categories."
  core_courses_by_parent_category(
    "The id of the category of the courses to return."
    categoryid: core_id!

    "Order of courses to return."
    sort: core_course_sort_order = SORTORDER
  ): [core_course!]!

  "Return all courses that match the search parameters for the course selector"
  core_course_selector(input: course_selector_input!): core_course_selector_result!

  "Returns a tree with links to course administration settings pages"
  core_course_settings_navigation_tree(context_id: core_id!, page_url: param_url!): core_course_settings_navigation_tree!

  "Returns a tree with links to course module administration settings pages"
  core_course_module_settings_navigation_tree(context_id: core_id!, page_url: param_url!): core_course_module_settings_navigation_tree!

  "Returns a result of non interative enrolment pending approval information."
  core_non_interactive_enrol_pending_approval_info(course_id: core_id!): core_non_interactive_enrol_pending_approval_info_result!

  core_editor(
    """
    The context's id where editor is being used.
    Default to context system if none is provided.
    """
    context_id: param_integer

    """
    The editor's format that is used to get the editor we want.
    By default format that is set in user's preference will used if none is given.
    """
    format: param_integer

    """
    Name of the front-end framework we are using.
    Only editors supporting this framework will be returned.
    """
    framework: param_alpha
  ): core_editor!

  "A query to find the hashtags base on the pattern passed."
  core_hashtags_by_pattern(pattern: param_text!, contextid: param_integer, component: param_component, area: param_area): [core_hashtag!]!

  core_lang_strings(
    lang: param_lang!

    "ids argument is in the form \"$identifier, $component\" the same as in the 'str' mustache helper"
    ids: [String!]!
  ): [core_lang_string!]!
  core_get_linkmetadata(url: param_url!): core_link
  core_template(name: param_alphanumext!, component: param_component!, theme: param_theme!): String!

  "Query to get settings for specific theme."
  core_get_theme_settings(theme: param_component!, tenant_id: core_id, draft_id: Int): core_theme_settings_result!

  "Return a users own profile information"
  core_user_own_profile: core_user!

  "Return filtered list of users in the system."
  core_users(query: core_users_query): core_users_result!

  "Return a paginated list of static audiences in the system."
  core_cohort_static_cohorts(
    "Sort and pagination information to control the data returned."
    query: core_cohort_static_cohorts_query
  ): core_cohort_static_cohorts_result!

  "Return result that indicates the user is the member of the audience."
  core_cohort_is_user_member(
    "Target user who is the member of the audience."
    user: core_user_user_reference!

    "Target audience."
    cohort: core_cohort_cohort_reference!
  ): core_cohort_is_user_member_result!

  "Query to get course completion data for a user in a course."
  core_completion_get_course_completion(
    """
    The parameter object for this query.
    This object requires a user reference and course reference.
    """
    query: core_completion_get_course_completion_input!
  ): core_completion_get_course_completion_result!

  "Query to check whether the user is enrolled a course."
  core_course_is_user_enrolled(
    "Target course."
    course: core_course_course_reference!

    "Target user."
    user: core_user_user_reference!
  ): core_course_is_user_enrolled_result!

  "Retrieve a paginated list of all available courses."
  core_course_courses(
    "The query parameter contains pagination and sorting information."
    query: core_course_courses_query
  ): core_course_courses_result!

  """
  Return a paginated list of users in the system. Deleted users are excluded and multitenancy restrictions apply.
  By default, only active (non-suspended) users are included.
  """
  core_user_users(
    "Sort and pagination information to control the data returned."
    query: core_user_users_query
  ): core_user_users_result!

  "Return a specific user in the system."
  core_user_user(
    "Input object specifying data for the existing user."
    reference: core_user_user_reference!
  ): core_user_user_result!

  "Return a single course from its ID if the user can access it"
  core_enrol_course_info(
    "The mandatory id of the course"
    courseid: core_id!
  ): core_enrol_course_info

  "Return array of approvers for this application stage and approval level"
  mod_approval_application_approvers(input: mod_approval_application_approvers_input!): [core_user!]!

  "Form schema for particular application"
  mod_approval_application_form_schema(input: mod_approval_application_input!, full_schema: Boolean): mod_approval_application_form_schema!

  "A list of the approval workflows to which the current user can apply."
  mod_approval_create_new_application_menu(query: mod_approval_create_new_application_menu_query): [mod_approval_new_application_menu_item!]!

