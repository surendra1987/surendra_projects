input auth_ssosaml_update_plugin_config_input {
  fields: [auth_ssosaml_update_plugin_config_field_input!]!
}

input auth_ssosaml_update_plugin_config_field_input {
  id: String!
  locked: auth_ssosaml_field_locking_status!
}

enum auth_ssosaml_field_locking_status {
  UNLOCKED
  UNLOCKED_IF_EMPTY
  LOCKED
}

"""
Constant for which specific type of metadata is selected.
NONE is only available during initial setup.
"""
enum auth_ssosaml_metadata_source {
  URL
  XML
  NONE
}

"Constant for defining how a mapping field updates."
enum auth_ssosaml_map_attributes {
  CREATE
  LOGIN
}

"Constant for the log status."
enum auth_ssosaml_log_status {
  ERROR
  INCOMPLETE
  SUCCESS
}

"Constant for the auto linking existing accounts."
enum auth_ssosaml_idp_autolink_users {
  LINK_WITH_CONFIRMATION
  LINK_NO_CONFIRMATION
  NO_LINK
}

"""
The Metadata configuration. Source indicates which of the XML or URL fields are active.
The non-active field will return a NULL.
"""
type auth_ssosaml_metadata {
  "Metadata source"
  source: auth_ssosaml_metadata_source!

  "Metadata URL"
  url: String

  "Manually entered metadata XML"
  xml: String
}

"One specific mapping field, Totara to Remote."
type auth_ssosaml_totara_remote_map {
  "Name of the Totara field to update"
  internal: String!

  "Name of the remote field to update"
  external: String!

  "Whether to update the field in Totara on each login."
  update: auth_ssosaml_map_attributes!
}

"Algorithms available for signing."
enum auth_ssosaml_signing_algorithm {
  SHA1
  SHA256
  SHA386
  SHA512
}

"Configuration options that only apply to SAML"
type auth_ssosaml_saml_config {
  "Whether the metadata should be signed."
  sign_metadata: Boolean!

  "What algorithm should be used for signing."
  signing_algorithm: auth_ssosaml_signing_algorithm!

  "Whether assertions should be signed or not."
  wants_assertions_signed: Boolean!

  "Indicates to the IdP that all authentication requests will be signed."
  authnrequests_signed: Boolean!

  "Which SAML NameID format to request."
  nameid_format: String

  "Custom entity ID."
  entity_id: String
}

type auth_ssosaml_field_mapping_config {
  "Delimiter used to join multi-value attributes"
  delimiter: String

  "Local to Remote field mappings."
  field_maps: [auth_ssosaml_totara_remote_map!]!
}

"Identity Provider(IdP)"
type auth_ssosaml_idp {
  "ID of IdP"
  id: core_id!

  "Metadata configuration."
  metadata: auth_ssosaml_metadata!

  "Label for the login method"
  label(format: core_format = PLAIN): String

  "Field to use as user identifier on IdP end"
  idp_user_id_field: String

  "Field to use as user identifier on Totara end"
  totara_user_id_field: String

  "Allow users to be created in Totara when they login into the IdP"
  create_users: Boolean!

  "Enabled\/disabled"
  status: Boolean!

  "Debug mode"
  debug: Boolean!

  "SAML Config"
  saml_config: auth_ssosaml_saml_config!

  "Settings for the field mappings"
  field_mapping_config: auth_ssosaml_field_mapping_config!

  "If true, logout in totara will trigger a logout in the IdP"
  logout_idp: Boolean!

  "URL to redirect to after the final logout."
  logout_url: String

  "Indicates what auto link option is set."
  autolink_users: auth_ssosaml_idp_autolink_users!

  "Whether this IdP is hidden from the login screen."
  login_hide: Boolean!
}

"Result of the IdPs list query."
type auth_ssosaml_idps_result {
