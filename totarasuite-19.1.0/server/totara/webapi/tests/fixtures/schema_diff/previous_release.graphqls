type editor_weka_extension {
  name: String!
  tuicomponent: String!

  "Options is an json_encoded string, this string should be decoded in the front-end and pass it to extension itself."
  options: String
}

type editor_weka_editor {
  extensions(
    """
    The component where the editor weka is used.
    Deprecated in favour of usage_identifier.
    """
    component: param_component

    """
    The specific area within the component where the editor weka is used.
    Deprecated in favour of usage_identifier.
    """
    area: param_area

    """
    Optional parameter to get the extensions. When the argument is passed, then it will
    superceed the component/area to get the list of extension. Otherwise, by default the
    list of extensions can be found by component/area
    """
    variant_name: param_alphaext

    """
    The parameter to pass down to the variant, as it can be treated as
    extra data.
    """
    usage_identifier: core_editor_usage_identifier

    """
    A json encoded text string that the front-end want to pass to the server side for loading any other extra
    extension, for example: specific custom extension.
    
    The json content should look like:
    [
      {
        "name": "valid_extension_name",
        "options": {
          "some_key": "valid_extension_value"
        }
      },
      // And the list of extensions go on with the schema as same as object above.
    ]
    """
    extra_extensions: param_text
  ): [editor_weka_extension!]!

  "To tell whether we are displaying toolbar or not."
  showtoolbar(component: param_component, area: param_area): Boolean! @deprecated(reason: "The showtoolbar field had been deprecated and no longer needed")

  "The upload repository data"
  repository_data: editor_weka_repository_data! @deprecated(reason: "The repository_data is now fetched from query editor_weka_repository_data")

  """
  The context's id where the editor is being used. This has to be done as part of constructing
  editor, most likely it can be context_system, if the component that is using editor is not providing one.
  """
  context_id: Int!

  "The current files within weka editor. If there are any."
  files(
    """
    The component where the files are living.
    By default, this will be 'user'
    """
    component: param_component

    """
    The file area which identify the place within the component.
    By default, the value for this key will be 'draft'
    """
    file_area: param_area

    "The item's id - which should be the file draft id id."
    item_id: param_integer
  ): [editor_weka_file!]! @deprecated(reason: "The files field got deprecated in favour of query editor_weka_draft_file")

  "The current draft files within weka editor. If there are any."
  draft_files(
    "The id of the draft area"
    draft_item_id: param_integer
  ): [editor_weka_file!]! @deprecated(reason: "The files field got deprecated in favour of query editor_weka_draft_file")
}

type editor_weka_file {
  filename: String!
  file_size: Int!
  mime_type: String!
  url(force_download: Boolean!): String!

  "If media_type is null, then this file is not a part of any embbedded-able media files."
  media_type: editor_weka_media_type

  item_id: Int!
}

type editor_weka_repository_data {
  url: String!
  repository_id: Int!

  """
  A numeric string that represent for bytes. We are using string instead of
  integer for this one because, graphql Integer does not support up to 64-bit integers but only 32-bit integers.
  """
  max_bytes: String!
}

type editor_weka_file_draft_area {
  url: String!
  draftid: Int!
  repositoryid: Int!
}

enum editor_weka_media_type {
  IMAGE
  VIDEO
  AUDIO
}

"""
Constants for the type of activity completion tracking.
Note: This is just the tracking type and doesn't contain the conditions for automatic completion.
"""
enum format_pathway_course_activity_completion_tracking {
  NONE
  MANUAL
  AUTOMATIC
}

"This type represents the data required by the requested by the `get_course_navigation` query"
type format_pathway_course_navigation {
  "An array of course_section objects. The array is a mandatory field, but it may be empty."
  sections: [format_pathway_course_section]!
}

"""
The first nested layer in the `get_course_navigation` query. This layer represents the topics
in the navigation bar on the left-hand side.
"""
type format_pathway_course_section {
  "The section (topic) ID"
  id: core_id!

  "The formal title of the course section"
  title: String

  "Whether there are any restrictions set on the section that would prevent access"
  available: Boolean!

  "Any reasons given why a course would not be available"
  availablereason(format: core_format = HTML): [String]

  "Whether a user can view the course (if the course is hidden, or empty, for example)"
  visible: Boolean!

  "An array of objects representing the modules associated with each topic."
  modules: [format_pathway_course_module]
}

"""
The second nested layer in the `get_course_navigation` query. This layer represents the modules
and activities used by individual topics.
"""
type format_pathway_course_module {
  "The module ID"
  id: core_id!

  "The formal name of this module"
  name: String!

  "The type of module (assignment, quiz, etc)"
  modtype: String!

  "Whether there are any restrictions set on the section that would prevent access"
  available: Boolean!

  "Any reasons given why a course would not be available"
  availablereason(format: core_format = HTML): [String]

  "Whether a user can view the course (if the course is hidden, or empty, for example)"
  visible: Boolean!

  "The completion settings of the course module"
  completion: String

  "Whether completion is enabled for the course module"
  completionenabled: Boolean!

  "Whether this activity type is blacklisted in pathway format"
  blacklisted: Boolean!

  "The URL to follow to view this module"
  viewurl: String!
}

"The completion status of a course module"
type format_pathway_course_activity_completion {
  "The course module id"
  cmid: core_id!

  "Does the course module have completion enabled"
  activitycompletionenabled: Boolean!

  "The type of completion tracking the course module uses."
  activitycompletiontracking: format_pathway_course_activity_completion_tracking!

  "Has the course module been completed"
  completionstatus: Boolean!

  "The activity url"
  activity_url: String

  "Course module completion status description"
  completion_status_description: String
}

"The user course navigation"
type format_pathway_get_course_user_navigation {
  "The course user navigation name"
  name: String!

  "The course user navigation url"
  url: String!

  "The course user navigation title"
  title: String!
}

"The header information to display when a pathway course is loaded"
type format_pathway_course_header_info {
  "The course ID that confirms the same course that was requested was returned"
  id: core_id!

  "The display name of the course in the header"
  full_name(format: core_format = PLAIN): String!

  "A link to the header image of the course"
  image_url: String
}

"Key completion information to be displayed in a pathway course header"
type format_pathway_course_completion_for_header {
  """
  The enablecompletion (enable completion tracking) flag for the course.
  This is set to false when the user does not have access to the course (e.g. not enrolled)
  """
  completionenabled: Boolean!

  """
  An array of course completion information. We present this information in the same way
  as it is returned by the core_course type, for consistency.
  When the user does not have access to the course, this field is an empty array.
  """
  completion: format_pathway_course_completion_for_header_substring_information
}

"Key completion information for a single course. This information will be displayed in a pathway course header."
type format_pathway_course_completion_for_header_substring_information {
  "This is the mapped enum value corresponding to the statuskey below."
  status: String!

  "This is the readable key for the status. It indicates which lozenge will appear in the header."
  statuskey: String!

  "A percentage value between 0.00 and 100.00 representing the completion of the course."
  progress: Float!
}

"Result of non interactive enrolment."
type format_pathway_request_non_interactive_enrol_result {
  "Whether to enrol the course."
  success: Boolean!

  "Redirect application url."
  redirect_url: String!
}

"A client is used to access the API, it controls authentication and stores settings relating to API usage."
type totara_api_client {
  id: core_id!

  "Clients can be at the system level or within a tenant. If provided this identifies the tenant, otherwise it is a system client."
  tenant_id: core_id

  "Name used to identify the client."
  name(format: core_string_format = HTML): String!

  "User defined description of the purpose\/use for this client."
  description(format: core_text_format = HTML): String

  "Internal OAuth2 client providers for this client."
  oauth2_client_providers: [totara_oauth2_client_provider!]!

  "The enabled status of the client."
  status: Boolean

  "The service account for the API user linked to this API client."
  service_account: totara_api_client_service_account

  "The number of currently active tokens for this client ."
  active_tokens: Int
}

"Client settings are used to configure api client, it stores settings relating to API client."
type totara_api_client_settings {
  id: core_id!
  client_id: core_id!

  "It used to set complexity for an API client"
  client_rate_limit: Int!

  "It used to set default token expiry time for an API client"
  default_token_expiry_time: Int!

  "Used to set the type of response debug for an API client"
  response_debug: totara_api_client_response_debug

  "Used to turn on GraphQL introspection"
  enable_introspection: Boolean

  "Used to set an allowed ip range"
  allowed_ip_list(format: core_text_format = HTML): String
}

type totara_api_global_client_settings {
  "It used to set global rate limit for an API client"
  site_rate_limit: Int

  "It used to set global client rate limit for an API client"
  client_rate_limit: Int

  "It used to set global query depth for an API client"
  max_query_depth: Int

  "It used to set global complex cost for an API client"
  max_complexity_cost: Int

  "It used to set global token expiry time for an API client"
  default_token_expiry_time: Int

  "Used to set the type of response debug for an API client"
  response_debug: totara_api_client_response_debug
}

"Constant representing debug response type."
enum totara_api_client_response_debug {
  NONE
  NORMAL
  DEVELOPER
}

