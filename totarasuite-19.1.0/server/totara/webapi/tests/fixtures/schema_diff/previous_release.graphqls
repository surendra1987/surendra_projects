"Moodle configure type, containing basic moodle information"
type bi_intellidata_moodleconfig {
  "Moodle version"
  version: String!

  "Moodle release date"
  release: String!

  "Database type"
  dbtype: String!

  "Moodle workplace exists or not"
  moodleworkplace: Boolean

  "Totara version"
  totaraversion: String!
}

"Cron configure type that maps into table 'task_scheduled'"
type bi_intellidata_cronconfig {
  "Id"
  id: Int!

  "Component"
  component: String

  "Classname"
  classname: String

  "Last run time"
  lastruntime(format: core_date_format = TIMESTAMP): core_date

  "Next run time"
  nextruntime(format: core_date_format = TIMESTAMP): core_date

  "Blocking"
  blocking: String

  "Minute"
  minute: String

  "Hour"
  hour: String

  "Day"
  day: String

  "Month"
  month: String

  "Day of week"
  dayofweek: String

  "Fail delay"
  faildelay: String

  "Disabled"
  disabled: Int

  "Customised"
  customised: Int
}

"The Intelliboard plugin's configuration settings."
type bi_intellidata_pluginconfig {
  "Configuration title."
  title: String!

  "Configuration settings."
  items: [bi_intellidata_pluginconfig_setting!]!
}

"An Intelliboard plugin configuration setting."
type bi_intellidata_pluginconfig_setting {
  "Type"
  type: String!

  "Subtype that represents setting, eg. checkbox."
  subtype: String!

  "Title"
  title: String!

  "Name"
  name: String!

  "Group title for each setting section name. Note: this could be null."
  grouptitle: String

  """
  Setting value. If the value is an array it will be encoded into a string.
  If the subtype is 'checkbox', the value will be 1 or 0.
  """
  value: String!
}

"Plugin config result type, containing moodle config, bi_intellidata config and cron config."
type bi_intellidata_plugin_config_result {
  "Moodle configure"
  moodleconfig: bi_intellidata_moodleconfig!

  "Cron configure"
  cronconfig: [bi_intellidata_cronconfig]!

  "bi_intellidata plugin configure"
  pluginconfig: bi_intellidata_pluginconfig!

  "Plugin version"
  pluginversion: String!
}

"A type that represents a field in a unified table of a database schema."
type bi_intellidata_dbschema_unified_table_field {
  "The name of the field."
  field_name: String!

  "The data type of the field."
  type: String!

  "A description of the field."
  description: String

  "The default value of the field."
  default: String

  "Whether the field can be null."
  null: Boolean
}

"A type that represents a unified table in a database schema."
type bi_intellidata_dbschema_unified_table {
  "The name of the entity that the table represents."
  name: String!

  "The fields that the table has."
  fields: [bi_intellidata_dbschema_unified_table_field!]!
}

"A type that represents the result of a unified database schema query."
type bi_intellidata_dbschema_unified_result {
  items: [bi_intellidata_dbschema_unified_table!]!
}

"The response after a request was made to set the enable\/disable status of the IntelliBoard plugin."
type bi_intellidata_enable_processing_result {
  "If the enable setting was successful, this should be 'ok'."
  data: String!
}

"The parameters to go in a request to enable_processing."
input bi_intellidata_enable_processing_input {
  "1 or 0. 1 - Enable, 0 - Disable."
  status: Int!

  "The URL to send a callback request to Intelliboard Next."
  callbackurl: String
}

"The input data for querying by datatype."
input bi_intellidata_live_data_input {
  "The 'data source', usually a database table, for querying. Datatypes allowed are: 'roles', 'categories', 'courses' ."
  datatype: String!
}

"Response type for a live data query."
type bi_intellidata_live_data_result {
  "A JSON-encoded string representing live data records."
  data: String!
}

"A type that represents a field in a custom table of a database schema."
type bi_intellidata_dbschema_custom_table_field {
  "The data type of the field."
  type: String!

  "The name of the field."
  name: String!

  "Whether the field has default value."
  has_default: Boolean

  "The maximum length of the field."
  max_length: Int

  "Whether the field is primary key."
  primary_key: Boolean

  "Whether the field cannot be null."
  not_null: Boolean

  "Whether the field can auto increment."
  auto_increment: Boolean

  "The default value of the field."
  default_value: String
}

"A type that represents a table key in a custom table of a database schema."
type bi_intellidata_dbschema_custom_table_key {
  "The type of key, eg. primary."
  name: String!

  "The fields that the key is related to."
  fields: [String!]!

  "The table the key refers to"
  reftable: String

  "The fields the key refers to"
  reffields: [String]!
}

"A type that represents a custom table in a database schema."
type bi_intellidata_dbschema_custom_table {
  "The name of the table."
  name: String!

  "The fields that the table has."
  fields: [bi_intellidata_dbschema_custom_table_field!]!

  "The plugin type."
  plugintype: String

  "The plugin name."
  plugin: String

  "The keys that the table has."
  keys: [bi_intellidata_dbschema_custom_table_key]!
}

"A type that represents the result of a custom database schema query."
type bi_intellidata_dbschema_custom_result {
  items: [bi_intellidata_dbschema_custom_table]!
}

"Input data for fetching data files."
input bi_intellidata_data_files_input {
  "Start time."
  timestart: core_date

  "End time."
  timeend: core_date

  "Data type filter."
  datatype: String
}

"Metadata type for data files."
type bi_intellidata_data_files_metadata {
  "Last migration date."
  lastmigrationdate(format: core_date_format = TIMESTAMP): core_date!

  "Last export date."
  lastexportdate(format: core_date_format = TIMESTAMP): core_date!

  "Plugin version."
  pluginversion: String!
}

"Type representing a single data file."
type bi_intellidata_data_files_file_instance {
  "File name."
  filename: String!

  "File area."
  filearea: String!

  "Item ID."
  itemid: Int!

  "File path."
  filepath: String!

  "MIME type."
  mimetype: String

  "File size."
  filesize: Int!

  "Time last modified."
  timemodified(format: core_date_format = TIMESTAMP): core_date

  "Indicates whether the file is external or not."
  isexternalfile: Boolean!

  "File URL."
  fileurl: String!

  "Repository type, if the file is external."
  repositorytype: String
}

"Type representing a collection of data files."
type bi_intellidata_data_files_file {
  "Data type filter."
  datatype: String!

  "List of files."
  files: [bi_intellidata_data_files_file_instance]!

  "List of migration files."
  migration_files: [bi_intellidata_data_files_file_instance]!
}

"Type representing the result of a data_files query."
type bi_intellidata_data_files_result {
  "List of data files."
  items: [bi_intellidata_data_files_file]!

  "Metadata for the data files."
  metadata: bi_intellidata_data_files_metadata!
}

"Type representing the result of a export_data mutation."
type bi_intellidata_export_data_result {
  "List of data files."
  items: [bi_intellidata_data_files_file]!

  "Metadata for the data files."
  metadata: bi_intellidata_data_files_metadata!
}

"Trigger to export files after inserting custom table. 0 = do not process migration, 1 = create an ad-hoc task to process export with the next cron run. Default value is 0."
input bi_intellidata_set_datatype_input {
  "Custom table name(s)"
  datatypes: [String!]!

  """
  Trigger to export files after inserting custom table
  0 - do not process migration
  1 - create ad-hoc task to process export with next cron run
  Default value is 0
  """
  exportfiles: Int

  """
  Callback URL to send request when export completed.
  Working only if not empty and exportfiles = 1
  """
  callbackurl: String
}

"The result of attempting to set a custom datatype."
type bi_intellidata_set_datatype_result {
  "The operation result message."
  data: String!
}

"Represents a goal status value."
type perform_goal_status {
  "Status code."
  id: String

  "Status display label."
  label: String
}

"Goal type object, containing information about a personal or team goal. All available fields are listed. No fields are required."
type perform_goal_goal {
  "Internal database ID of the goal."
  id: core_id

  "Parent context ID of the goal object."
  context_id: core_id

  "Perform goal category, associates a category name with a goaltype subplugin."
  category_id: core_id

  "The user that 'owns' the goal, i.e. is responsible for managing it. Usually the owner will be the same person as the user who initially created the goal."
  owner: core_user

  "The user who is the subject of the goal, i.e. who the goal is applied to."
  user: core_user

  "The display name for the goal."
  name: String

  "An external identifier for the goal."
  id_number: String

  "Comments or a statement about the goal."
  description(format: core_format = HTML): String

  "Goal assignment type, e.g. self, manager, etc."
  assignment_type: String!

  "The goaltype plugin used to implement this goal."
  plugin_name: String!

  "The date the goal will commence."
  start_date(format: core_date_format = DATELONG): core_date

  "The type of the target for the goal, e.g. date, percentage, currency, number, manual."
  target_type: String

  "The date the goal is expected to be completed\/closed."
  target_date(format: core_date_format = DATELONG): core_date

  "The expected value for achieving the goal."
  target_value: Float

  "The value towards the goal currently achieved so far."
  current_value: Float

  "The date the current_value was most recently updated."
  current_value_updated_at(format: core_date_format = DATELONG): core_date

  "The current status of the goal."
  status: perform_goal_status

  "The date the status was most recently updated."
  status_updated_at(format: core_date_format = DATELONG): core_date

  "The date the goal was closed, or null if the goal is still active."
  closed_at(format: core_date_format = DATELONG): core_date

  "The date the goal record was first created."
  created_at(format: core_date_format = DATELONG): core_date

  "The date the goal record was last updated."
  updated_at(format: core_date_format = DATELONG): core_date

  "The number of comments for the goal."
  comment_count: Int!

  "Tasks meta information for this goal."
  goal_tasks_metadata: perform_goal_goal_tasks_metadata!
}

"Tasks meta information for a goal."
type perform_goal_goal_tasks_metadata {
  "Total number of tasks for a goal."
  total_count: Int!

  "Number of completed tasks for a goal."
  completed_count: Int!
}

"Values returned from a perform_goal_update_progress operation."
type perform_goal_update_progress_result {
  "The value towards the goal currently achieved so far."
  current_value: Float

  "The current status of the goal."
  status: perform_goal_status!
}

"Goal metadata from a goal create\/retrieve\/update\/delete operation."
type perform_goal_goal_raw_data {
  "Allowed goal status values."
  available_statuses: [perform_goal_status!]!

  "Associated goal description."
  description(format: core_format = RAW): String

  "Associated goal start date."
  start_date: totara_core_date_time_setting

  "Associated goal target completion date."
  target_date: totara_core_date_time_setting
}

"Permissions for the current user to manipulate goals."
type perform_goal_permissions {
  "Whether the current user can create\/update\/delete goals."
  can_manage: Boolean!

  "Whether the current user can update a goal's status."
  can_update_status: Boolean!
}

"The result returned from a goal create\/update\/delete operation."
type perform_goal_crud_result {
  "Goal type object, containing information about a personal goal."
  goal: perform_goal_goal!

  "Goal metadata from a goal create\/update\/delete operation."
  raw: perform_goal_goal_raw_data!

  "Permissions for the current user to manipulate goals."
  permissions: perform_goal_permissions!
}

"The result returned from a goal view operation."
type perform_goal_view_result {
  "Goal type object, containing information about a personal or team goal."
  goal: perform_goal_goal

  "Goal metadata from a goal retrieve operation."
  raw: perform_goal_goal_raw_data

  "Permissions for the current user to manipulate goals."
  permissions: perform_goal_permissions
}

"The result returned from a query to find the available goals for a user."
type perform_goal_user_goals_result {
  "Retrieved personal goals."
  items: [perform_goal_user_goals_result_item]

  "Total number of personal goals retrieved across all pages."
  total: Int!

  "Pointer to next page of personal goals."
  next_cursor: String!

  "Flag indicating if the user has at least one goal (independent of filter input)."
  has_goals: Boolean!

  "Indicates if the operation succeeded."
  success: Boolean!

  "Error messages if the operation failed."
  errors: perform_goal_operation_error
}

"Information on one goal."
type perform_goal_user_goals_result_item {
  "Retrieved goal."
  goal: perform_goal_goal!

  "Permissions for the goal with respect to the currently logged-in user."
  permissions: perform_goal_permissions!
}

"The result returned from a goal delete operation."
type perform_goal_delete_result {
  "Whether the current goal successfully deleted."
  success: Boolean!
}

"Describes an error that occurred when doing a goal related query\/mutation."
type perform_goal_operation_error {
  "An error code representing this particular class of error."
  code: String

  "Human readable string describing the error."
  message: String
}

"""
Input for identifying a goal.

The goal must be specified by providing one of the following:

* The goal's internal database id
* The user's id_number

A goal reference must uniquely identify a single goal to be valid.
"""
input perform_goal_reference {
  "The database ID of the goal."
  id: core_id

  "An external identifier for the goal."
  id_number: String
}

"Input provided when creating a goal. Some fields are required."
input perform_goal_create_input {
  "Parent context ID of the goal object."
  context_id: core_id

  """
  The user that 'owns' the goal, i.e. is responsible for managing it. Usually the owner will be the same person as the user who initially created the goal.
  If this field is not included, the default owner will be set to the user making the request.
  """
  owner: core_user_user_reference

  "The user who is the subject of the goal, i.e. who the goal is applied to."
  user: core_user_user_reference

  "The display name for the goal."
  name: String!

  "An external identifier for the goal."
  id_number: String

  "Comments or a statement about the goal."
  description: String

  "The date the goal will commence."
  start_date: core_date!

  """
  The type of the target for the goal, e.g. date, percentage, currency, number, manual.
  Current target type is 'date'.
  """
  target_type: String

  "The date the goal is expected to be completed\/closed."
  target_date: core_date!

  "The expected value for achieving the goal."
  target_value: Float!

  "The value towards the goal currently achieved so far."
  current_value: Float

  "The current status of the goal (currently supports the 'not_started', 'in_progress', 'completed', 'cancelled')."
  status: String

  "The module\/plugin name (currently supports the 'basic' plugin)."
  plugin_name: String
}

"Input provided when updating a goal. No field is required."
input perform_goal_update_input {
  "The display name for the goal."
  name: String

  "An external identifier for the goal."
  id_number: String

  "Comments or a statement about the goal."
  description: String

  "The date the goal will commence."
  start_date: core_date

  "The type of the target for the goal, e.g. date, percentage, currency, number, manual."
  target_type: String

  "The date the goal is expected to be completed\/closed."
  target_date: core_date

  "The expected value for achieving the goal."
  target_value: Float
}

"Values to update a goal's progress with."
input perform_goal_update_progress_input {
  "The value towards the goal currently achieved so far."
  current_value: Float!

  "The current status of the goal."
  status: String!
}

"Filters input provided when querying available goals for a user."
input perform_goal_user_goals_filter {
  "The user whose goals will be fetched. If left out, defaults to the logged-in user."
  user: core_user_user_reference

  "A search term for searching the goals"
  search: param_text

  "A list of status codes to filter for. The status codes correspond to the status class names."
  status: [param_alphaext!]
}

"Options input provided when querying available goals for a user."
input perform_goal_user_goals_options {
  "Sort by a given field. Possible values are created_at, target_date, most_complete, least_complete."
  sort_by: param_alphaext
}

"Input provided when querying available goals for a user."
input perform_goal_user_goals_input {
  "Filters when querying available goals for a user."
  filters: perform_goal_user_goals_filter

  "Options (e.g. sorting) when querying available goals for a user."
  options: perform_goal_user_goals_options

  "Standard pagination input."
  pagination: core_pagination_input
}

"Represents a goal task resource."
type perform_goal_goal_task_resource {
  "Internal database ID of the resource."
  id: core_id!

  "Internal database ID of the parent task."
  task_id: core_id!

  "Points to the id in the table of the given resource type."
  resource_id: core_id!

  "Numerical code for the resource type."
  resource_type: Int!

  "The date the resource was first created."
  created_at(format: core_date_format = DATELONG): core_date!

  "Extra data about the goal_task resource, e.g. a course resource."
  resource_custom_data: String
}

"Represents a goal task value."
type perform_goal_goal_task {
  "Internal database ID of the task."
  id: core_id!

  "Internal database ID of the parent goal."
  goal_id: core_id!

  "Task description."
  description(format: core_format = PLAIN): String

  "The date the task was completed."
  completed_at(format: core_date_format = DATELONG): core_date

  "The date the task was first created."
  created_at(format: core_date_format = DATELONG): core_date!

  "The date the task was last updated."
  updated_at(format: core_date_format = DATELONG): core_date

  """
  Indicates whether the associated resource (e.g. course) exists. If this is false
  and resource_id is not null, it means the resource originally existed but has
  now been deleted.
  """
  resource_exists: Boolean

  "Indicates whether the resource is viewable by the current user."
  resource_can_view: Boolean!

  "Associated resource if any."
  resource: perform_goal_goal_task_resource
}

"The result returned from a get goal tasks operation."
type perform_goal_get_goal_tasks_result {
  "The database ID of the parent goal."
  goal_id: core_id!

  "The list of goal_task items associated with a goal."
  tasks: [perform_goal_goal_task!]

  "Total number of tasks in this goal."
  total: Int!

  "Total number of _completed_ tasks in this goal."
  completed: Int!
}

"The result returned from a goal task create\/update\/set progress operation."
type perform_goal_task_upsert_result {
  "Task type object, containing information about a goal task."
  goal_task: perform_goal_goal_task

  "Indicates if the operation succeeded."
  success: Boolean!

  "Error messages if the operation failed."
  errors: perform_goal_task_operation_error
}

"The result returned from a goal task delete operation."
type perform_goal_task_delete_result {
  "Whether the current goal task successfully deleted."
  success: Boolean!
}

"Describes an error that occurred when doing a goal task related query\/mutation."
type perform_goal_task_operation_error {
  "An error code representing this particular class of error."
  code: String

  "Human readable string describing the error."
  message: String
}

"""
Input for identifying a goal task.

The task must be specified by providing one of these:

* The task's internal database id (if present, always ignores the position value
  and goal id below).

* Its position in a parent goal's list. Note this value ranges from 0 (earliest
  created task) to <list size - 1> (latest created task).
"""
input perform_goal_task_reference {
  "The database ID of the parent goal."
  goal_id: core_id

  "The database ID of the task."
  id: core_id

  "The task's position in the parent goal's list."
  ordinal: Int
}

"Input provided when creating a goal task. Some fields are required."
input perform_goal_task_create_input {
  "Internal database ID of the parent goal."
  goal_id: core_id!

  "Goal task description."
  description: param_text

  "Points to the id in the table of the given resource type."
  resource_id: core_id

  "Numerical code for the resource type corresponding to constants in the back end code."
  resource_type: Int
}

"Input provided when updating a goal task."
input perform_goal_task_update_input {
  "Input value(s) for identifying a goal task."
  goal_task_reference: perform_goal_task_reference!

  "Goal task description."
  description: param_text

  "Points to the id in the table of the given resource type."
  resource_id: core_id

  "Numerical code for the resource type corresponding to constants in the back end code."
  resource_type: Int
}

"Input provided when setting a goal task's progress."
input perform_goal_task_set_progress_input {
  "Input value(s) for identifying a goal task."
  goal_task_reference: perform_goal_task_reference!

  "The task completion status: 0 = false, anything else = true."
  completed: Int!
}

"Allowed perform perform overview item states."
enum perform_goal_overview_state {
  not_started
  not_progressed
  progressed
  achieved
}

"Describes perform goal target date details."
type perform_goal_overview_due {
  "Target date."
  date(format: core_date_format = DATELONG): core_date

  "Whether the goal is due soon ie within the week."
  due_soon: Boolean!

  "Whether the goal is past the target date."
  overdue: Boolean!
}

"Last update information for a perform goal overview item."
type perform_goal_overview_last_update {
  "Last updated timestamp."
  date(format: core_date_format = DATELONG): core_date

  "What changed at the last update."
  description(format: core_format = PLAIN): String
}

"Goal overview items according to their state."
type perform_goal_overview_by_states {
  achieved: [perform_goal_overview_item!]!
  progressed: [perform_goal_overview_item!]!
  not_progressed: [perform_goal_overview_item!]!
  not_started: [perform_goal_overview_item!]!
}

"Overview item counts according to their state."
type perform_goal_overview_state_counts {
  achieved: Int!
  progressed: Int!
  not_progressed: Int!
  not_started: Int!
}

"Overview item details."
type perform_goal_overview_item {
  """
  For historical reasons, this is needed as a counter. It is not related to
  anything else.
  """
  id: Int!

  "Perform goal id."
  raw_id: Int!

  "Goal name."
  name(format: core_format = PLAIN): String!

  "Goal description."
  description(format: core_text_format = HTML): String

  "Link to perform goal if it is allowed."
  url(format: core_format = PLAIN): String

  "Goal achievement date."
  achievement_date(format: core_date_format = DATELONG): core_date

  "Goal started date."
  assignment_date(format: core_date_format = DATELONG): core_date!

  "Goal last modified time details."
  last_update: perform_goal_overview_last_update!

  "Goal target date details."
  due: perform_goal_overview_due!
}

"Main overview results."
type perform_goal_overview_result {
  "Total number of overview items retrieved for all states."
  total: Int!

  "How many goals are due soon ie within a week."
  due_soon: Int!

  "Individual overview item counts per state."
  state_counts: perform_goal_overview_state_counts!

  "Overview items."
  goals: perform_goal_overview_by_states!
}

"Overview goals by state"
type perform_goal_overview_by_state_result {
  "Total number of overview items retrieved across all pages."
  total: Int!

  "Retrieved overview items."
  goals: [perform_goal_overview_item!]!
}

"Overview query filters."
input perform_goal_overview_filters {
  "User id for whom to get overview data."
  id: core_id!

  """
  Indicates the start of the overview period. The overview period is from this
  time days ago in the past to today.
  """
  period: param_integer!

  "Targetted overview state (required for the perform_goal_overview_by_state query)"
  status: perform_goal_overview_state
}

"Overview query parameters."
input perform_goal_overview_input {
  "Filter values."
  filters: perform_goal_overview_filters!

  """
  Attribute on which to sort retrieved overview data.
  Valid columns for sorting are: id, name, target_date and last_updated.
  """
  sort: [core_sort_input]
}

"Overview query by state parameters."
input perform_goal_overview_by_state_input {
  "Filter values"
  filters: perform_goal_overview_filters!

  """
  Attribute on which to sort retrieved overview data
  Valid columns for sorting are: id, name, target_date and last_updated.
  """
  sort: [core_sort_input]

  "Pagination details"
  pagination: core_pagination_input!
}

"Represents a status change made in the subject instance."
type perform_goal_perform_status_change {
