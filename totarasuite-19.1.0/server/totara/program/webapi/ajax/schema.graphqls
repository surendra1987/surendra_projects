"""
Input schema for request an extension.
"""
input totara_program_request_extension_input {
  """
  Internal database id of program.
  """
  id: core_id!
  """
  Extension datetime.
  """
  extdatetime: core_date!
  """
  Extension reason.
  """
  extreason: param_text!
}

"""
Request an extension result type.
"""
type totara_program_request_extension_result {
  """
  Whether the requested is sent.
  """
  success: Boolean!
  """
  Success message.
  """
  message: String!
}

extend type Query {
  """
  Query to return a specific program the user can access, given its ID.
  """
  totara_program_program(programid: core_id!): totara_program_program!
  """
  Query to return all programs the user can access.
  """
  totara_program_programs: [totara_program_program!]!
  """
  Query to return all programs assigned to the current user.
  """
  totara_program_my_programs: [totara_program_program!]!
}

extend type Mutation {
  """
  Mark a program as viewed for the current user, the program_id is mandatory
  """
  totara_program_program_view(program_id: core_id!): Boolean!
  """
  Mutation to request an extension.
  """
  totara_program_request_extension(
    input: totara_program_request_extension_input!
  ): totara_program_request_extension_result!
}
