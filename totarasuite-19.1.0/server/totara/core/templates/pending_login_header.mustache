{{!
    @template totara_core/masthead_login

    Constructs the totara masthead for the modern login screens.

    Classes required for JS:
    * totaraNav

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * masthead_lang: Has masthead language data
    * masthead_logo: Has masthead_logo data
}}
<div class="totaraNav totaraNav--login">

    <nav class="totaraNav_prim" aria-label="{{#str}}primarynavigation, totara_core{{/str}}">
        <div class="container-fluid">
            {{! Logo here }}
            {{#masthead_logo}}{{> totara_core/masthead_logo }}{{/masthead_logo}}

            <div class="totaraNav_prim--side">

              {{! Language button here }}
              {{#masthead_lang}}{{> totara_core/masthead_lang }}{{/masthead_lang}}
            </div>
        </div>
    </nav>
</div>