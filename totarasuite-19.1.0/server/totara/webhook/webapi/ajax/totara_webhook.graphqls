  """
  Is the webhook enable/disabled - enabled = true
  """
  status: param_boolean

  """
  Do we send the payload immediately after the event
  """
  immediate: param_boolean

  """
  The authorisation class to use for webhooks (e.g. webhook_hmac_auth).
  When given, the class must be full namespace of a class which implements the
  webhook_auth interface. Default is totara_webhook\auth\webhook_hmac_auth.
  """
  auth_class: String
}

"""
Result from updating an existing webhook.
"""
type totara_webhook_update_totara_webhook_result {
