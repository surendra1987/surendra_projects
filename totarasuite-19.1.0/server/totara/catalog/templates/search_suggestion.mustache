{{!

    @template totara_catalog/search_suggestion

    This template generates Catalog suggestion/did you mean link.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * has_suggestion: Bool, Has data for single buttons
    * suggestion: string, suggested text
    * suggestion_link_pre: string, display text before the link
    * suggestion_link_post: string, display text after the link
}}
<div data-tw-catalogSearchSuggestion="">
  {{#has_suggestion}}
    <div class="tw-catalogSearchSuggestion"
         data-core-autoinitialise="true"
         data-core-autoinitialise-amd="totara_catalog/search_suggestion">
      {{suggestion_link_pre}}<a class="tw-catalogSearchSuggestion_link" href="#"
                                aria-controls="catalog_fts_input"
                                aria-label="{{suggestion_aria_label}}"
                                data-suggestion="{{suggestion}}">{{suggestion}}</a>{{suggestion_link_post}}
    </div>
  {{/has_suggestion}}
</div>