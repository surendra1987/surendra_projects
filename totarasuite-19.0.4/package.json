{
    "name": "totaraenterprise",
    "private": true,
    "description": "Totara Enterprise",
    "scripts": {
        "tui-build": "node ./client/tooling/tasks/build.js --mode production --mode development",
        "tui-build-prod": "node ./client/tooling/tasks/build.js --mode production",
        "tui-build-dev": "node ./client/tooling/tasks/build.js --mode development",
        "tui-build-watch": "node ./client/tooling/tasks/build.js --mode development --watch",
        "tui-style-check": "node ./client/tooling/tasks/lint.js --formatting",
        "tui-style-fix": "node ./client/tooling/tasks/lint.js --fix --formatting",
        "tui-style-format": "node ./client/tooling/tasks/prettier.js --write",
        "tui-test": "cross-env NODE_OPTIONS='--unhandled-rejections=strict' jest",
        "tui-test-watch": "jest --watch",
        "tui-ci": "npm run tui-build && npm run tui-test && npm run tui-style-check",
        "tui-clean": "node ./client/tooling/tasks/clean.js",
        "setup-hooks": "node ./client/tooling/tasks/setup-hooks.js",
        "remove-hooks": "node ./client/tooling/tasks/remove-hooks.js",
        "generate-configs": "node ./client/tooling/tasks/generate-configs.js",
        "tui-init": "node ./client/tooling/tasks/tui-init.js",
        "tui-test-modern": "echo 'tui-test-modern was deprecated in Totara 18, please use tui-test' && npm run --silent tui-test",
        "tui-test-legacy": "echo 'tui-test-legacy was deprecated in Totara 18, please use tui-test' && npm run --silent tui-test"
    },
    "@comment dependencies": [
        "Dependencies are used by webpack to bundle libraries that will be delievered to the client",
        "as part of the vendor bundle. Dependencies need to be locked to a single version for this reason",
        "and upgrades need to adhere to our third party library policy.",
        "Details and licenses:",
        " - @apollo/client",
        "       https://www.npmjs.com/package/@apollo/client - MIT",
        " - @babel/runtime",
        "       https://www.npmjs.com/package/@babel/runtime - MIT",
        " - @skirtle/vue-vnode-utils",
        "       https://www.npmjs.com/package/@skirtle/vue-vnode-utils - MIT",
        " - @vue/apollo-composable",
        "       https://www.npmjs.com/package/@vue/apollo-composable - MIT",
        " - @vue/apollo-option",
        "       https://www.npmjs.com/package/@vue/apollo-option - MIT",
        " - @xstate/inspect",
        "       https://www.npmjs.com/package/@xstate/inspect - MIT",
        " - chart.js",
        "       https://www.npmjs.com/package/chart.js - MIT",
        " - chartjs-plugin-doughnutlabel",
        "       https://www.npmjs.com/package/chartjs-plugin-doughnutlabel - MIT (ISC)",
        " - date-fns",
        "       https://github.com/date-fns/date-fns - MIT",
        " - graphql",
        "       https://www.npmjs.com/package/graphql - MIT",
        " - graphql-tag",
        "       https://www.npmjs.com/package/graphql-tag - MIT",
        " - prosemirror-commands",
        "       https://github.com/ProseMirror/prosemirror-commands - MIT",
        " - prosemirror-dropcursor",
        "       https://github.com/ProseMirror/prosemirror-dropcursor - MIT",
        " - prosemirror-gapcursor",
        "       https://github.com/ProseMirror/prosemirror-gapcursor - MIT",
        " - prosemirror-history",
        "       https://github.com/ProseMirror/prosemirror-history - MIT",
        " - prosemirror-inputrules",
        "       https://github.com/ProseMirror/prosemirror-inputrules - MIT",
        " - prosemirror-keymap",
        "       https://github.com/ProseMirror/prosemirror-keymap - MIT",
        " - prosemirror-model",
        "       https://github.com/ProseMirror/prosemirror-model - MIT",
        " - prosemirror-state",
        "       https://github.com/ProseMirror/prosemirror-state - MIT",
        " - prosemirror-transform",
        "       https://github.com/ProseMirror/prosemirror-transform - MIT",
        " - prosemirror-view",
        "       https://github.com/ProseMirror/prosemirror-view - MIT",
        " - reselect",
        "       https://www.npmjs.com/package/reselect - MIT",
        " - traverse",
        "       https://www.npmjs.com/package/traverse - MIT",
        " - video.js",
        "       https://github.com/videojs/video.js - Apache 2.0",
        " - vue",
        "       https://www.npmjs.com/package/vue - MIT",
        " - xstate",
        "       https://www.npmjs.com/package/xstate - MIT"
    ],
    "dependencies": {
        "@apollo/client": "3.8.10",
        "@babel/runtime": "7.24.1",
        "@skirtle/vue-vnode-utils": "0.1.4",
        "@vue/apollo-composable": "4.2.1",
        "@vue/apollo-option": "4.2.0",
        "@xstate/inspect": "0.4.1",
        "@xstate/test": "0.4.1",
        "chart.js": "2.9.4",
        "chartjs-plugin-doughnutlabel": "2.0.3",
        "date-fns": "2.30.0",
